# Copy to .env. Only MCC_DIR is required. Everything else is read from reclaimer.config.json;
# uncomment a line here only to override it for Docker.

# Your Halo: The Master Chief Collection folder (Windows paths work with Docker Desktop).
MCC_DIR=D:\SteamLibrary\steamapps\common\Halo The Master Chief Collection

# UDP game ports (each is also that server's RCON TCP port). Must differ. Compose publishes these,
# so if you change a port in reclaimer.config.json, set it here too.
#CAMPAIGN_PORT=12345
#MULTIPLAYER_PORT=12346

#CAMPAIGN_NAME=Legendary Co-op
#MULTIPLAYER_NAME=LAN Multiplayer

# Campaign mission number (Halo 3: 3010 3020 3030 3040 3050 3070 3100 3110 3120;
# ODST: 4100 5000 6100 6110 6120 6130 6140 6150 5200 5300 4200). Restart to change it.
#MISSION=3010

# Seconds players get to vote between multiplayer games.
#VOTE_SECONDS=20

# Leave empty to generate one (kept in the server volume as /server/rcon-password.txt).
#RCON_PASSWORD=

# Pin a release instead of the newest, then `docker compose build`.
#RECLAIMER_VERSION=v0.10.7
